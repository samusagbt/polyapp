# Polymarket Dashboard Environment Variables
# This app uses public APIs and doesn't require API keys

# API Endpoints (already configured in code)
# VITE_GAMMA_API_URL=https://gamma-api.polymarket.com
# VITE_CLOB_API_URL=https://clob.polymarket.com

# Optional: Analytics or tracking IDs
# VITE_ANALYTICS_ID=

# Optional: Custom branding
# VITE_APP_NAME=Polymarket Dashboard

# Note: All read operations are public and don't require authentication
